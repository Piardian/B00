# ======================================================================
# 🌺 BEGONYA UNIFIED ENVIRONMENT CONFIGURATION 🌺
# ======================================================================

# --- MAKRO MOTORU (GOOGLE GEMINI 4-KEY DUAL CASCADE & FRED) ---
GEMINI_USER_A_KEY=your_gemini_api_key_1
GEMINI_USER_B_KEY=your_gemini_api_key_2
GEMINI_USER_C_KEY=your_gemini_api_key_3
GEMINI_USER_D_KEY=your_gemini_api_key_4
GEMINI_API_KEY=your_primary_gemini_api_key
FRED_API_KEY=your_fred_api_key

# --- SMC MOTORU (TWELVE DATA & TELEGRAM BİLDİRİMLERİ) ---
PORT=3000
TWELVE_DATA_API_KEY=your_twelvedata_api_key_here
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
REQUIRE_TELEGRAM_READINESS=false

# --- KİLLZONE ZAMAN AYARLARI ---
ENABLE_KILLZONE=true
LONDON=true
LONDON_START=10:00
LONDON_END=19:00
NEWYORK=true
NEWYORK_START=15:00
NEWYORK_END=00:00
NY_CLOSE=true
NY_CLOSE_START=22:00
NY_CLOSE_END=00:00
